# Export these variables explicitly; no .env file is loaded automatically.
ENVIRONMENT=test
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/DISPOSABLE_DATABASE
# Integration tests require a separate, local, disposable target and opt-in.
TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/DISPOSABLE_DATABASE
TEST_DATABASE_ALLOW_DDL=no
